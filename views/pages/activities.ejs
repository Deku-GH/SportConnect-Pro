<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Activities - Sconnect Pro</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->
    <%- include('../partials/header.ejs') %>


        <!-- ================= MAIN ================= -->
        <main class="container py-5">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-5">

                <div>
                    <h1 class="fw-bold mb-1">
                        <i class="bi bi-trophy"></i>
                        Activities
                    </h1>

                    <p class="text-muted mb-0">
                        Gestion des activités sportives
                    </p>
                </div>

                <!-- Add Activity -->
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createActivityModal">
                    + Add Activity
                </button>

            </div>


            <!-- ================= EMPTY STATE ================= -->
            <% if (!activities || activities.length===0) { %>

                <div class="text-center py-5">

                    <div class="display-1 text-muted">
                        🏆
                    </div>

                    <h3 class="mt-3">
                        Aucune activité
                    </h3>

                    <p class="text-muted">
                        Vous n'avez pas encore créé d'activité.
                    </p>

                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createActivityModal">
                        Créer une activité
                    </button>

                </div>

                <% } else { %>


                    <!-- ================= ACTIVITIES GRID ================= -->
                    <div class="row g-4">

                        <% activities.forEach(activity=> { %>

                            <div class="col-12 col-md-6 col-lg-4">

                                <div class="card h-100 shadow-sm border-0">

                                    <div class="card-body">

                                        <!-- Icon -->
                                        <div class="mb-3">
                                            <span
                                                class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle"
                                                style="width:50px;height:50px;font-size:24px;">
                                                🏆
                                            </span>
                                        </div>


                                        <!-- Activity name -->
                                        <h4 class="card-title fw-bold">
                                            <%= activity.name %>
                                        </h4>


                                        <!-- Description -->
                                        <% if (activity.description) { %>

                                            <p class="card-text text-muted">
                                                <%= activity.description %>
                                            </p>

                                            <% } else { %>

                                                <p class="card-text text-muted">
                                                    Aucune description
                                                </p>

                                                <% } %>


                                                    <!-- Price -->
                                                    <div class="mb-2">

                                                        <strong>Prix :</strong>

                                                        <%= activity.base_price %> €

                                                    </div>


                                                    <!-- Capacity -->
                                                    <div class="mb-2">

                                                        <strong>Capacité :</strong>

                                                        <%= activity.max_capacity %> personnes

                                                    </div>


                                                    <!-- Age -->
                                                    <div class="mb-2">

                                                        <strong>Âge :</strong>

                                                        <span class="badge bg-secondary">

                                                            <%= activity.age_category %>

                                                        </span>

                                                    </div>


                                                    <!-- Schedule -->
                                                    <div class="mb-2">

                                                        <strong>Horaire :</strong>

                                                        <%= activity.day_of_week %>

                                                            <br>

                                                            <small class="text-muted">

                                                                <%= activity.start_time.substring(0, 5) %>
                                                                    -
                                                                    <%= activity.end_time.substring(0, 5) %>

                                                            </small>

                                                    </div>


                                                    <!-- Medical -->
                                                    <div class="mb-2">

                                                        <strong>Certificat médical :</strong>

                                                        <%= activity.medical_validity_years %> an(s)

                                                    </div>


                                                    <hr>


                                                    <!-- Facility -->
                                                    <div class="mb-2">

                                                        <strong>Infrastructure :</strong>

                                                        <span class="text-muted">

                                                            <%= activity.facility_name %>

                                                        </span>

                                                    </div>


                                                    <!-- Club -->
                                                    <div class="mb-3">

                                                        <strong>Club :</strong>

                                                        <span class="text-muted">

                                                            <%= activity.club_name %>

                                                        </span>

                                                    </div>


                                                    <!-- Actions -->
                                                    <div class="d-flex gap-2">

                                                        <a href="/activities/<%= activity.id %>"
                                                            class="btn btn-outline-primary btn-sm flex-grow-1">
                                                            View Details
                                                        </a>


                                                    

                                                        

                                                    </div>

                                    </div>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

        </main>


        <!-- ================= CREATE ACTIVITY MODAL ================= -->

        <%-include('../partials/activity-form.ejs')%>


        <!-- ================= FOOTER ================= -->
        <%- include('../partials/footer.ejs') %>


            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>