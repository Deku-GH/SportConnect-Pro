<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= facility.name %> - Sconnect Pro
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/header.ejs') %>


    <main class="container py-5">

        <!-- BACK -->

        <a
            href="/facilities"
            class="btn btn-outline-secondary mb-4">

            ← Back to Facilities

        </a>


        <!-- FACILITY DETAILS -->

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="fs-1 mb-3">
                            🏟️
                        </div>

                        <h1 class="h2 fw-bold">
                            <%= facility.name %>
                        </h1>

                        <p class="text-secondary">
                            <%= facility.type %>
                        </p>

                    </div>


                    <!-- EDIT BUTTON -->

                    <button
                        type="button"
                        class="btn btn-warning"
                        data-bs-toggle="modal"
                        data-bs-target="#editFacilityModal">

                        ✏️ Edit

                    </button>

                </div>


                <hr>


                <!-- INFORMATION -->

                <div class="row g-4 mt-2">

                    <div class="col-md-6">

                        <div class="p-3 bg-light rounded">

                            <small class="text-secondary">
                                Address
                            </small>

                            <h5 class="mb-0 mt-1">
                                📍 <%= facility.address %>
                            </h5>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="p-3 bg-light rounded">

                            <small class="text-secondary">
                                ERP Capacity
                            </small>

                            <h5 class="mb-0 mt-1">

                                👥 <%= facility.erp_capacity %>
                                people

                            </h5>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="p-3 bg-light rounded">

                            <small class="text-secondary">
                                Facility Type
                            </small>

                            <h5 class="mb-0 mt-1">
                                <%= facility.type %>
                            </h5>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="p-3 bg-light rounded">

                            <small class="text-secondary">
                                Divisible
                            </small>

                            <h5 class="mb-0 mt-1">

                                <% if (facility.is_divisible) { %>

                                    <span class="badge text-bg-success">
                                        Yes
                                    </span>

                                <% } else { %>

                                    <span class="badge text-bg-secondary">
                                        No
                                    </span>

                                <% } %>

                            </h5>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <!-- ================= EDIT MODAL ================= -->

    <div
        class="modal fade"
        id="editFacilityModal"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Edit Facility
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>


                <form
                    action="/facilities/<%= facility.id %>/update"
                    method="POST">

                    <div class="modal-body">

                        <!-- NAME -->

                        <div class="mb-3">

                            <label class="form-label">
                                Facility Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                value="<%= facility.name %>"
                                required>

                        </div>


                        <!-- TYPE -->

                        <div class="mb-3">

                            <label class="form-label">
                                Type
                            </label>

                            <input
                                type="text"
                                name="type"
                                class="form-control"
                                value="<%= facility.type %>"
                                required>

                        </div>


                        <!-- CAPACITY -->

                        <div class="mb-3">

                            <label class="form-label">
                                ERP Capacity
                            </label>

                            <input
                                type="number"
                                name="erp_capacity"
                                class="form-control"
                                value="<%= facility.erp_capacity %>"
                                min="1"
                                required>

                        </div>


                        <!-- ADDRESS -->

                        <div class="mb-3">

                            <label class="form-label">
                                Address
                            </label>

                            <input
                                type="text"
                                name="address"
                                class="form-control"
                                value="<%= facility.address %>"
                                required>

                        </div>


                        <!-- DIVISIBLE -->

                        <div class="form-check">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="is_divisible"
                                value="true"
                                <%= facility.is_divisible ? 'checked' : '' %>>

                            <label class="form-check-label">

                                This facility is divisible

                            </label>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button
                            type="submit"
                            class="btn btn-warning">

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <%- include('../partials/footer.ejs') %>


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>