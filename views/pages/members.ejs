<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sconnect Pro - Facilities</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Your CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/header.ejs') %>

        <div class="container py-5">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1 class="fw-bold mb-1">
                        Members
                    </h1>

                    <p class="text-muted mb-0">
                        Gestion des membres
                    </p>
                </div>

                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                    data-bs-target="#createMemberModal">
                    + Add Member
                </button>

            </div>


            <!-- MEMBERS -->
            <% if (!members || members.length===0) { %>

                <div class="card border-0 shadow-sm">

                    <div class="card-body text-center py-5">

                        <h4 class="fw-bold">
                            No members found
                        </h4>

                        <p class="text-muted">
                            There are currently no members registered.
                        </p>

                        <a href="/members/create" class="btn btn-primary">
                            Add First Member
                        </a>

                    </div>

                </div>

                <% } else { %>

                    <div class="row g-4">

                        <% members.forEach(member=> { %>

                            <div class="col-md-6 col-lg-4">

                                <div class="card h-100 shadow-sm border-0">

                                    <div class="card-body">

                                        <!-- NAME -->
                                        <div class="d-flex justify-content-between align-items-start mb-3">

                                            <div>

                                                <h5 class="fw-bold mb-1">
                                                    <%= member.first_name %>
                                                        <%= member.last_name %>
                                                </h5>

                                                <small class="text-muted">
                                                    Member #<%= member.id %>
                                                </small>

                                            </div>

                                            <% if (member.is_resident) { %>

                                                <span class="badge bg-success">
                                                    Resident
                                                </span>

                                                <% } else { %>

                                                    <span class="badge bg-secondary">
                                                        Non-resident
                                                    </span>

                                                    <% } %>

                                        </div>


                                        <!-- BIRTH DATE -->
                                        <div class="mb-2">

                                            <small class="text-muted">
                                                Birth date
                                            </small>

                                            <div>
                                                <%= member.birth_date %>
                                            </div>

                                        </div>


                                        <!-- ADDRESS -->
                                        <div class="mb-2">

                                            <small class="text-muted">
                                                Address
                                            </small>

                                            <div>
                                                <%= member.address || 'Not specified' %>
                                            </div>

                                        </div>


                                        <!-- FAMILY -->
                                        <div class="mb-2">

                                            <small class="text-muted">
                                                Family
                                            </small>

                                            <div>
                                                Family #<%= member.family_id %>
                                            </div>

                                        </div>


                                        <!-- MEDICAL STATUS -->
                                        <div class="mb-3">

                                            <small class="text-muted">
                                                Medical Status
                                            </small>

                                            <div class="mt-1">

                                                <% if (member.medical_status==='compliant' ) { %>

                                                    <span class="badge bg-success">
                                                        Compliant
                                                    </span>

                                                    <% } else { %>

                                                        <span class="badge bg-danger">
                                                            Medical non-compliant
                                                        </span>

                                                        <% } %>

                                            </div>

                                        </div>


                                        <!-- ACTIONS -->
                                        <div class="d-flex gap-2">

                                            <a href="/members/<%= member.id %>"
                                                class="btn btn-outline-primary btn-sm flex-grow-1">
                                                View Details
                                            </a>

                                            <form action="/members/<%= member.id %>/delete" method="POST">

                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to delete this member?')">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

        </div>
        <%- include('../partials/member-form.ejs') %>

            <%- include('../partials/footer.ejs') %>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
                </script>

</body>

</html>