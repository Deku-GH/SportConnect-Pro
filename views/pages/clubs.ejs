<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sconnect Pro - Clubs</title>


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


    <!-- Custom CSS -->

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ================= NAVBAR ================= -->

    <%- include('../partials/header.ejs') %>


        <!-- ================= MAIN ================= -->

        <main class="container py-5">


            <!-- ================= PAGE HEADER ================= -->

            <div class="d-flex justify-content-between align-items-center mb-5">

                <div>

                    <h1 class="fw-bold mb-2">
                        Clubs
                    </h1>

                    <p class="text-secondary mb-0">
                        Manage sports clubs and associations.
                    </p>

                </div>


                <!-- ADD CLUB -->

                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createClubModal">

                    + Add Club

                </button>

            </div>


            <!-- ================= CLUBS ================= -->

            <% if (!clubs || clubs.length===0) { %>


                <!-- EMPTY STATE -->

                <div class="card border-0 shadow-sm text-center py-5">

                    <div class="card-body">


                        <div class="fs-1 mb-3">
                            ⚽
                        </div>


                        <h2 class="h4 fw-bold">
                            No clubs found
                        </h2>


                        <p class="text-secondary mb-4">
                            You don't have any clubs yet.
                        </p>


                        <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                            data-bs-target="#createClubModal">

                            + Add your first club

                        </button>


                    </div>

                </div>


                <% } else { %>


                    <!-- ================= CLUB GRID ================= -->

                    <div class="row g-4">


                        <% clubs.forEach(club=> { %>


                            <div class="col-12 col-md-6 col-lg-4">


                                <div class="card h-100 border-0 shadow-sm">


                                    <div class="card-body">


                                        <!-- ICON -->

                                        <div class="bg-light rounded p-3 d-inline-flex mb-3">

                                            <span class="fs-3">
                                                ⚽
                                            </span>

                                        </div>


                                        <!-- NAME -->

                                        <h2 class="h5 fw-bold mb-2">

                                            <%= club.name %>

                                        </h2>


                                        <!-- DESCRIPTION -->

                                        <p class="text-secondary">

                                            <% if (club.description) { %>

                                                <%= club.description %>

                                                    <% } else { %>

                                                        No description available.

                                                        <% } %>

                                        </p>


                                        <!-- CONTACT -->

                                        <p class="mb-4">

                                            📞

                                            <strong>
                                                Contact:
                                            </strong>

                                            <%= club.contact || 'Not provided' %>

                                        </p>


                                        <!-- ACTIONS -->

                                        <div class="d-flex gap-2">


                                            <!-- DETAILS -->

                                            <a href="/clubs/<%= club.id %>" class="btn btn-dark flex-grow-1">

                                                View Details

                                            </a>


                                            <!-- DELETE -->

                                            <form action="/clubs/<%= club.id %>/delete" method="POST">

                                                <button type="submit" class="btn btn-outline-danger">

                                                    Delete

                                                </button>

                                            </form>


                                        </div>


                                    </div>

                                </div>

                            </div>


                            <% }) %>


                    </div>


                    <% } %>


        </main>


        <!-- ================= CREATE CLUB MODAL ================= -->

        <%- include('../partials/create_clubs.ejs') %>

        <!-- ================= FOOTER ================= -->

        <%- include('../partials/footer.ejs') %>


            <!-- ================= BOOTSTRAP JS ================= -->

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
            </script>


</body>

</html>